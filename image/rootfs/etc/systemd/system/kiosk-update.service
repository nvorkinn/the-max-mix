# Check the update channel now and install anything newer; on the dev and branch channels restart into it at once.
# The screen's Install starts this (kiosk-server, as the kiosk user: 50-kiosk-power.rules); the timer runs the same with
# --scheduled (kiosk-update-scheduled.service).
[Unit]
Description=Install THE MAX MIX's newest update
Wants=network-online.target
After=network-online.target rauc.service

[Service]
Type=oneshot
# On the Pi's own setup hotspot there is no internet (NetworkManager still counts it as up), so the job is skipped
# cleanly rather than failing; joining a real network starts it again (50-kiosk-online).
ExecCondition=/bin/sh -c 'ip route show default | grep -q .'
ExecStart=/usr/local/sbin/kiosk-update run
