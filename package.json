{
  "name": "the-max-mix",
  "version": "0.0.0",
  "private": true,
  "description": "THE MAX MIX: a fun collaborative Spotify tablet for Raspberry Pi 4 with Waveshare 7-inch touchscreen",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "start": "vite preview",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test --config e2e/playwright.config.ts",
    "lint": "eslint . --max-warnings 0",
    "lint:shell": "shellcheck ansible/roles/kiosk/files/bin/* ansible/tests/*.sh",
    "lint:md": "markdownlint-cli2",
    "lint:css": "stylelint \"src/**/*.css\" --max-warnings 0",
    "lint:unused-css": "node scripts/check-unused-css.ts",
    "lint:spelling": "cspell --no-progress --dot \"**/*\"",
    "lint:editorconfig": "editorconfig-checker",
    "knip": "knip",
    "lint:package-json": "npmPkgJsonLint . && node scripts/check-version-ranges.ts",
    "lint:lockfiles": "lockfile-lint --type npm --allowed-hosts npm --validate-https --validate-integrity --path package-lock.json && lockfile-lint --type npm --allowed-hosts npm --validate-https --validate-integrity --path ansible/roles/kiosk/files/kiosk-audio/package-lock.json",
    "typecheck": "tsc -b",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "node scripts/install-hooks.ts",
    "check": "npm run lint && npm run typecheck && npm run format:check && npm run lint:shell && npm run knip && npm run lint:spelling && npm run lint:editorconfig && npm run lint:md && npm run lint:css && npm run lint:unused-css && npm run lint:package-json && npm run lint:lockfiles"
  },
  "dependencies": {
    "@svrooij/sonos": "2.7.0",
    "lucide-react": "^1.70.0",
    "qrcode-generator": "2.0.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "^5.28.8",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "8.18.2",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^5.1.0",
    "@vitest/eslint-plugin": "^1.6.28",
    "cspell": "10.4.1",
    "dbus-native": "0.16.3",
    "eslint": "^10.14.0",
    "eslint-import-resolver-node": "^0.4.0",
    "eslint-plugin-import-x": "^4.18.1",
    "eslint-plugin-jest-dom": "^5.10.1",
    "eslint-plugin-jsx-a11y-x": "^0.2.0",
    "eslint-plugin-n": "^18.5.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-security": "^4.2.1",
    "eslint-plugin-sonarjs": "^4.2.2",
    "eslint-plugin-testing-library": "^7.16.2",
    "eslint-plugin-unicorn": "^79.0.0",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "jsdom": "^31.0.0",
    "knip": "6.44.2",
    "lint-staged": "^17.6.0",
    "lockfile-lint": "5.1.0",
    "markdownlint-cli2": "0.24.0",
    "npm-package-json-lint": "11.0.1",
    "prettier": "^3.9.10",
    "stylelint": "18.0.0",
    "stylelint-config-standard": "41.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.7",
    "vitest": "^5.0.5",
    "ws": "8.22.2"
  },
  "overrides": {
    "katex": "0.19.1",
    "re2js": "2.9.1"
  },
  "engines": {
    "node": ">=24"
  }
}
