#!/bin/bash
# Usage: kiosk-soloist-key KIOSK_USER < key
# Stores the Soloist API key (from https://developer.spotify.com/dashboard/soloist, made by a Spotify Premium account;
# each owner makes their own) for the kiosk user, then (re)starts the player, which waits for a key before it starts.
# The key comes on standard input so that it never shows in a command line, for example straight from the vault:
#   bw get password SPOTIFY_SOLOIST_API_KEY | ssh admin@the-max-mix.local sudo kiosk-soloist-key kiosk
set -euo pipefail

if (($# != 1)); then
  echo "usage: $0 KIOSK_USER < key" >&2
  exit 2
fi
user=$1
if [[ -t 0 ]]; then
  echo "kiosk-soloist-key: pipe the key in on standard input" >&2
  exit 2
fi

home=$(getent passwd "$user" | cut -d: -f6)
if [[ -z $home ]]; then
  echo "kiosk-soloist-key: no user $user" >&2
  exit 1
fi
# The same folder kiosk-soloist.service's StateDirectory= gives the player.
state=$home/.local/state/soloist
runuser -u "$user" -- mkdir -p "$state"
# The player locks its state folder while it runs, so it is stopped while the key is written.
systemctl --user -M "$user@" stop kiosk-soloist.service 2>/dev/null || true
runuser -u "$user" -- env STATE_DIRECTORY="$state" /usr/local/bin/soloist setup-api-key
systemctl --user -M "$user@" start kiosk-soloist.service
echo "kiosk-soloist-key: key stored; the player is restarting"
