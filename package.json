{
  "name": "the-max-mix",
  "version": "0.0.0",
  "private": true,
  "description": "THE MAX MIX: a fun collaborative Spotify tablet for Raspberry Pi 4 with Waveshare 7-inch touchscreen",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "web"
  ],
  "scripts": {
    "dev": "npm run dev --workspace web",
    "build": "npm run build --workspace web",
    "preview": "npm run preview --workspace web --",
    "start": "npm run preview --workspace web --",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test --config e2e/playwright.config.ts",
    "lint": "eslint . --max-warnings 0 --concurrency auto",
    "lint:shell": "shellcheck image/build.sh image/rootfs/usr/local/lib/the-max-mix/* image/rootfs/usr/local/bin/* image/rootfs/usr/local/sbin/*",
    "lint:image": "node scripts/check-image.ts",
    "lint:md": "markdownlint-cli2",
    "lint:css": "stylelint \"web/src/**/*.css\" --max-warnings 0",
    "lint:unused-css": "node scripts/check-unused-css.ts",
    "lint:spelling": "cspell --no-progress --dot \"**/*\"",
    "lint:stale-words": "cspell-check-unused-words",
    "lint:editorconfig": "editorconfig-checker",
    "knip": "knip",
    "lint:package-json": "npmPkgJsonLint . && node scripts/check-version-ranges.ts",
    "lint:lockfiles": "lockfile-lint --type npm --allowed-hosts npm --validate-https --validate-integrity --path package-lock.json && lockfile-lint --type npm --allowed-hosts npm --validate-https --validate-integrity --path server/package-lock.json",
    "typecheck": "tsc -b",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "node scripts/install-hooks.ts",
    "kiosk-screenshot": "node scripts/kiosk-screenshot.ts",
    "check": "npm run lint && npm run typecheck && npm run format:check && npm run lint:shell && npm run knip && npm run lint:spelling && npm run lint:editorconfig && npm run lint:md && npm run lint:css && npm run lint:unused-css && npm run lint:package-json && npm run lint:lockfiles && npm run lint:image"
  },
  "dependencies": {
    "@svrooij/sonos": "2.7.0",
    "qrcode-generator": "2.0.4"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "^5.30.6",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/ws": "8.18.2",
    "@vitest/coverage-v8": "^5.1.1",
    "@vitest/eslint-plugin": "^1.6.28",
    "cspell": "10.5.2",
    "cspell-check-unused-words": "1.6.3",
    "dbus-native": "0.16.3",
    "eslint": "^10.15.0",
    "eslint-import-resolver-node": "^0.4.0",
    "eslint-plugin-import-x": "^4.18.1",
    "eslint-plugin-jest-dom": "^5.11.0",
    "eslint-plugin-jsx-a11y-x": "^0.2.0",
    "eslint-plugin-n": "^18.5.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-security": "^4.2.1",
    "eslint-plugin-sonarjs": "^4.2.2",
    "eslint-plugin-testing-library": "^7.16.3",
    "eslint-plugin-unicorn": "^80.0.0",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "jsdom": "^31.0.1",
    "knip": "6.48.0",
    "lint-staged": "^17.6.2",
    "lockfile-lint": "5.1.0",
    "markdownlint-cli2": "0.24.2",
    "npm-package-json-lint": "11.0.1",
    "prettier": "^3.10.1",
    "stylelint": "18.1.0",
    "stylelint-config-standard": "41.1.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.74.0",
    "vitest": "^5.0.5",
    "ws": "8.23.0",
    "yaml": "2.9.1"
  },
  "overrides": {
    "katex": "0.19.1",
    "re2js": "2.9.1"
  },
  "engines": {
    "node": ">=24"
  }
}
