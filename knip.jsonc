{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  // Entry points come from knip's plugins rather than a list kept here: package.json scripts, index.html and the Vite and
  // Vitest configs, ESLint, Playwright (e2e/*.spec.ts), lint-staged and husky.
  // Files those do not reach directly (scripts/*.ts) are entries via package.json scripts.
  // ShellCheck and editorconfig-checker are system binaries installed separately (apt/brew/CI download), not npm dependencies.
  // The Pi's services are started by their systemd units (image/rootfs): kiosk-server, the updater, the health check,
  // RAUC's boot backend and the first-boot setup. The updater runs screen-mode.ts itself. scripts/pi/*.mts are run by hand
  // on a Pi over SSH.
  "entry": [
    "server/src/kiosk-server.ts",
    "server/src/screen-mode.ts",
    "server/src/kiosk-update.ts",
    "server/src/kiosk-health.ts",
    "server/src/rauc-backend.ts",
    "server/src/kiosk-first-boot.ts",
    "scripts/pi/*.mts"
  ],
  // The countdown-api submodule is its own project; the app only imports its types and generated client.
  "ignore": ["vendor/**"],
  "ignoreBinaries": ["shellcheck", "editorconfig-checker", "diskutil"]
}
