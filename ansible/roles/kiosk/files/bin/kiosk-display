#!/usr/bin/env bash
# Turns the screen off and on, inside the Cage session (it needs Cage's WAYLAND_DISPLAY):
#   kiosk-display off                  from swayidle (kiosk-session), once the app let the screen sleep and nobody touched it
#   kiosk-display on                   from swayidle at the first touch after that, from the kiosk-audio service when the
#                                      app wakes the screen for music that starts while it sleeps, and from
#                                      kiosk-session when the kiosk starts with a rotated screen
# Cage has no output power protocol, so the output is disabled and enabled again through wlr-randr. Without a signal
# an HDMI screen should turn its backlight off, as a DSI panel's driver does; the app's black sleep screen covers it if
# it does not.
# Cage has no setting for rotation or scale either: with KIOSK_SCREEN_ROTATION (90, 180 or 270 degrees, from
# /run/kiosk/screen.env, which screen-setup.ts writes as the kiosk starts) `on` also turns the output, and with
# KIOSK_SCREEN_SCALE (such as 1.5) it has Cage draw everything that much bigger. Every time, so both hold whatever
# enabling the output does.
set -u

# What wlr-randr is told about rotation and scale when it enables an output: nothing for no rotation, for a scale of 1,
# or for anything else.
settings=()
case ${KIOSK_SCREEN_ROTATION:-0} in
  90 | 180 | 270) settings+=(--transform "$KIOSK_SCREEN_ROTATION") ;;
esac
screen_scale=${KIOSK_SCREEN_SCALE:-1}
if [[ $screen_scale =~ ^[0-9]+(\.[0-9]+)?$ && ! $screen_scale =~ ^[01](\.0+)?$ ]]; then
  settings+=(--scale "$screen_scale")
fi

# The outputs Cage has: wlr-randr starts each one's block with its name at the start of a line.
outputs() {
  wlr-randr | awk '/^[^ \t]/ { print $1 }'
}

turn() {
  local state=$1 output status=0
  while read -r output; do
    [[ -n $output ]] || continue
    if [[ $state == on ]]; then
      # Enabling without a mode can fail where the firmware set none; the preferred mode is the one Cage started with.
      wlr-randr --output "$output" --on "${settings[@]}" \
        || wlr-randr --output "$output" --on --preferred "${settings[@]}" || status=1
    else
      wlr-randr --output "$output" --off || status=1
    fi
  done < <(outputs)
  return "$status"
}

case ${1:-} in
  on) turn on ;;
  off) turn off ;;
  *)
    echo "kiosk-display: unknown command: ${1:-}" >&2
    exit 1
    ;;
esac
