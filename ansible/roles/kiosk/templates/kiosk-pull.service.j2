# {{ ansible_managed }}
# Applies this repository's playbook (ansible/local.yml) at kiosk_pull_ref ({{ kiosk_pull_ref }}; "latest" is the latest
# GitHub release, which /usr/local/sbin/kiosk-pull looks up), so a release reaches a deployed device without
# reflashing it. A failure only shows up in the journal (journalctl -u kiosk-pull); nothing depends on this unit, so the
# kiosk keeps running, and the timer tries again later. It never restarts the kiosk: see kiosk-restart.timer.
# --only-if-changed skips the playbook when the checkout has not moved since the last run, so most runs are only a look at
# GitHub and a git fetch.
[Unit]
Description=Update THE MAX MIX kiosk with ansible-pull
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
Environment=HOME=/root
Environment=LC_ALL=C.UTF-8
Environment=ANSIBLE_NOCOLOR=1
Environment=GIT_TERMINAL_PROMPT=0
Nice=10
IOSchedulingClass=idle
TimeoutStartSec=30min
ExecStart=/usr/local/sbin/kiosk-pull {{ kiosk_pull_repo }} {{ kiosk_pull_ref }} {{ kiosk_pull_dir }} --only-if-changed
