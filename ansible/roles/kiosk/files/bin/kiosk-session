#!/usr/bin/env bash
# The one program Cage runs. Loops forever, running the app in Chromium. The app handles having no network itself: it
# opens Settings > Wi-Fi when it starts with none.
set -u

# The address comes from kiosk.service (kiosk_url in the Ansible role).
url=${KIOSK_URL:?KIOSK_URL is not set}
chromium_pid=/run/kiosk/chromium.pid

# DevTools for remote screenshots and inspecting the page (scripts/kiosk-screenshot.ts, through an SSH tunnel), and for
# the kiosk-audio service, which clears the other sites' sign-ins through it when someone signs out
# (pi/kiosk-audio/browser-data.ts). Chromium listens on 127.0.0.1 only, so nothing on the network reaches it.
devtools_port=9222

# When the app comes from this machine (the kiosk-audio service), wait for it to answer: the service starts with the
# kiosk user's session and may not be up yet. An app from elsewhere is started at once.
wait_app() {
  local i
  [[ $url == http://127.0.0.1:* ]] || return 0
  for ((i = 0; i < 30; i++)); do
    curl -fsS -o /dev/null "$url" 2> /dev/null && return 0
    sleep 1
  done
  echo "kiosk-session: the app at $url is not answering" >&2
}

# Shows the app until Chromium exits. The kiosk-audio service's watchdog stops Chromium through the pid file when the
# app stops sending heartbeats, and the loop below starts it again.
run_chromium() {
  chromium --kiosk --ozone-platform=wayland --noerrdialogs --disable-infobars --no-first-run --password-store=basic \
    --autoplay-policy=no-user-gesture-required --disable-session-crashed-bubble --overscroll-history-navigation=0 \
    --remote-debugging-port="$devtools_port" \
    "$1" &
  echo $! > "$chromium_pid"
  wait $!
  rm -f "$chromium_pid"
}

# Screen sleep: once nothing holds the screen awake (the app's wake lock reaches Cage as an idle inhibitor) and nobody
# has touched it for this long, turn the output off; the next touch turns it on. swayidle ends with Cage.
screen_off_after=${KIOSK_SCREEN_OFF_AFTER:-0}
if [[ $screen_off_after =~ ^[1-9][0-9]*$ ]] && command -v swayidle > /dev/null; then
  swayidle timeout "$screen_off_after" '/usr/local/bin/kiosk-display off' resume '/usr/local/bin/kiosk-display on' &
fi

# A rotated screen (kiosk_screen_rotation in the Ansible role): Cage starts every output as the panel is, so turn it before
# Chromium opens its window.
[[ ${KIOSK_SCREEN_ROTATION:-0} == 0 ]] || /usr/local/bin/kiosk-display on

# Cage does not signal this script when it stops, and it waits for us to exit (kiosk.service sends the signal from ExecStop).
# Stop the app with us so nothing is left running without a compositor.
trap 'kill $(jobs -p) 2> /dev/null; exit 0' TERM

while true; do
  wait_app
  run_chromium "$url"
  # Never spin if an app fails to start.
  sleep 1
done
