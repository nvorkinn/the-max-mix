# {{ ansible_managed }}
# A user unit, enabled for every user but run only for the kiosk user: it needs that user's PipeWire session, which
# kiosk.service's login session starts.
[Unit]
Description=THE MAX MIX audio routing (keeps the browser's sound on the chosen AirPlay speakers)
ConditionUser={{ kiosk_user }}
Wants=pipewire.service wireplumber.service
After=pipewire.service wireplumber.service

[Service]
Environment=KIOSK_APP_ORIGIN={{ kiosk_app_origin }}
ExecStart=/usr/bin/node {{ kiosk_audio_dir }}/kiosk-audio.ts watch
Restart=always
RestartSec=2
NoNewPrivileges=yes
LockPersonality=yes
# PipeWire's socket, the app's requests on 127.0.0.1 (server.ts listens there only), and the sonos-ts library (sonos.ts),
# which finds the Sonos speakers on the home network and talks to them, and reads the network interfaces over netlink. So there is no
# IP address allow list: the speakers are wherever the home network puts them.
RestrictAddressFamilies=AF_UNIX AF_INET AF_NETLINK

[Install]
WantedBy=default.target
