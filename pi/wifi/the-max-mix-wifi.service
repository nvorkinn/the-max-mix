[Unit]
Description=THE MAX MIX Wi-Fi setup portal
Documentation=https://github.com/nvorkinn/the-max-mix/blob/main/pi/wifi/README.md
After=NetworkManager.service
Wants=NetworkManager.service

[Service]
Type=simple
ExecStart=/usr/bin/python3 -B /opt/the-max-mix/wifi/portal.py
Restart=on-failure
RestartSec=3

# Root is needed to manage NetworkManager connections and to bind port 80 on the setup network; everything else is
# dropped. The service only talks to NetworkManager and systemd over D-Bus (a UNIX socket), so it needs no capability
# beyond binding port 80 and reading the kiosk user's env file. If a hardening line ever breaks nmcli on a device,
# relax it with a drop-in (systemctl edit the-max-mix-wifi) rather than editing this file.
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_NET_BIND_SERVICE CAP_DAC_READ_SEARCH
PrivateTmp=yes
ProtectHome=read-only
ProtectSystem=strict
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
UMask=0077

[Install]
WantedBy=multi-user.target
