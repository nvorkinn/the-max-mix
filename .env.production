# countdown-server, which the kiosk registers with and reads its config from (src/countdown/server.ts).
# app.countdown.build is the dev server (countdown.build redirects to it, and a redirect would drop the device secret
# from the config route), countdown.run the production one; the Max Mix has one deployment, on dev.
VITE_COUNTDOWN_SERVER=https://app.countdown.build
# Whether the Settings tab shows the server's config site inside it (?embed=1): off until the site's embedded mode is
# live; until then the tab links to the site.
VITE_COUNTDOWN_EMBED=off
