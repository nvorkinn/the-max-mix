{
  "name": "the-max-mix",
  "version": "0.0.0",
  "private": true,
  "description": "THE MAX MIX: a fun collaborative Spotify tablet for Raspberry Pi 4 with Waveshare 7-inch touchscreen",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "start": "vite preview",
    "kiosk:mac": "bash scripts/start-kiosk-mac.sh",
    "test": "vitest run && bash scripts/test-kiosk.sh",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test --config e2e/playwright.config.ts",
    "lint": "eslint . --max-warnings 0",
    "lint:shell": "shellcheck scripts/*.sh pi/image/stage-maxmix/prerun.sh pi/image/stage-maxmix/*/*.sh pi/image/stage-maxmix/*/files/*.sh",
    "lint:md": "markdownlint-cli2",
    "lint:yaml": "yamllint \".github/**/*.{yml,yaml}\" \"ansible/**/*.{yml,yaml}\" \"*.{yml,yaml}\"",
    "lint:css": "stylelint \"src/**/*.css\" --max-warnings 0",
    "lint:spelling": "cspell --no-progress --dot \"**/*\"",
    "lint:editorconfig": "editorconfig-checker",
    "knip": "knip",
    "lint:package-json": "npmPkgJsonLint . && node scripts/check-version-ranges.ts",
    "lint:lockfiles": "lockfile-lint --type npm --allowed-hosts npm --validate-https --validate-integrity --path package-lock.json && npm ci --dry-run --ignore-scripts --no-audit --no-fund",
    "typecheck": "tsc -b",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "node scripts/install-hooks.ts",
    "check": "npm run lint && npm run typecheck && npm run format:check && npm run lint:shell && npm run knip && npm run lint:spelling && npm run lint:editorconfig && npm run lint:md && npm run lint:yaml && npm run lint:css && npm run lint:package-json && npm run lint:lockfiles"
  },
  "dependencies": {
    "canvas-confetti": "^1.9.4",
    "lucide-react": "^1.61.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "^5.28.8",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "@vitest/eslint-plugin": "^1.6.28",
    "cspell": "10.4.0",
    "eslint": "^10.13.0",
    "eslint-import-resolver-node": "^0.4.0",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-jest-dom": "^5.10.1",
    "eslint-plugin-jsx-a11y-x": "^0.2.0",
    "eslint-plugin-n": "^18.5.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-security": "^4.2.0",
    "eslint-plugin-sonarjs": "^4.2.2",
    "eslint-plugin-testing-library": "^7.16.2",
    "eslint-plugin-unicorn": "^79.0.0",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "jsdom": "^30.1.3",
    "knip": "6.43.0",
    "lint-staged": "^17.6.0",
    "lockfile-lint": "5.1.0",
    "markdownlint-cli2": "0.24.0",
    "npm-package-json-lint": "11.0.0",
    "postcss": "^8.5.31",
    "prettier": "^3.9.10",
    "stylelint": "17.16.0",
    "stylelint-config-standard": "40.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "yaml-lint": "1.7.0"
  },
  "overrides": {
    "katex": "0.19.1",
    "re2js": "2.9.1"
  },
  "engines": {
    "node": ">=24"
  }
}
