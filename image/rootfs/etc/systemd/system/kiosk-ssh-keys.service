# Fetches the admin user's SSH keys from GitHub (nvorkinn). A failure only shows up in the journal
# (journalctl -u kiosk-ssh-keys): the keys that are there stay, and the timer tries again.
[Unit]
Description=Fetch the admin user's SSH keys from GitHub
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# On the Pi's own setup hotspot there is no internet (NetworkManager still counts it as up), so the job is skipped
# cleanly rather than failing; joining a real network starts it again (50-kiosk-online).
ExecCondition=/bin/sh -c 'ip route show default | grep -q .'
ExecStart=/usr/local/sbin/kiosk-ssh-keys nvorkinn admin
TimeoutStartSec=2min
