# {{ ansible_managed }}
# The address THE MAX MIX kiosk opens: kiosk_url plus ?kiosk=1, which turns on the kiosk-only settings.
# Change kiosk_url in your ansible-pull variables file and pull again, or edit this and run:
#   systemctl --user restart the-max-mix-kiosk.service
KIOSK_URL={{ kiosk_launch_url }}
KIOSK_STARTUP_TIMEOUT={{ kiosk_startup_timeout }}
