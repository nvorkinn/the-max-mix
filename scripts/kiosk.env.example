# Runtime settings for THE MAX MIX on the kiosk. Copied to kiosk.env next to the releases on first install and kept
# across upgrades. Restart afterwards: sudo systemctl restart the-max-mix.service
# The Spotify client ID is built into the release; the redirect address to register in the Spotify dashboard is
# http://127.0.0.1:<PORT>/ (3000 unless changed below).
PORT=3000
HOST=127.0.0.1
