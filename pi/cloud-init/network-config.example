# The Wi-Fi the Pi uses for its setup, at the owner's place. Copy this file to network-config on the SD card's boot
# partition and fill in the network (or let Raspberry Pi Imager write it). It is for the first boot only: the playbook
# removes it from the card once the Pi has the network, and later Wi-Fi is set up in the app. See README.md.
network:
  version: 2
  wifis:
    renderer: NetworkManager
    wlan0:
      dhcp4: true
      optional: true
      # Raspberry Pi OS keeps Wi-Fi off until the country is set (the playbook sets kiosk_wifi_country later).
      regulatory-domain: GB
      access-points:
        'Your Wi-Fi name':
          password: 'your Wi-Fi password'
