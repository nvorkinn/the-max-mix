# {{ ansible_managed }}
# Spotify Soloist builds stop working 90 days after they were built, so the Pi fetches the latest one regularly.
[Unit]
Description=Install the latest Spotify Soloist regularly

[Timer]
OnBootSec={{ kiosk_soloist_update_boot_delay }}
OnUnitInactiveSec={{ kiosk_soloist_update_interval }}
RandomizedDelaySec=30min

[Install]
WantedBy=timers.target
