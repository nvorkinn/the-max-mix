# pi-gen settings for a hand-run build (see README.md). The pi-image workflow passes the same values to its pi-gen action.
IMG_NAME=the-max-mix
RELEASE=trixie
TARGET_HOSTNAME=the-max-mix
LOCALE_DEFAULT=en_GB.UTF-8
TIMEZONE_DEFAULT=Europe/London
KEYBOARD_KEYMAP=gb
KEYBOARD_LAYOUT="English (UK)"
WPA_COUNTRY=GB
ENABLE_SSH=1
# The kiosk account is pi-gen's first user. pi-gen insists on a password when it must not be renamed on first boot, so
# set one here: the kiosk stage replaces it with a locked one.
FIRST_USER_NAME=kiosk
FIRST_USER_PASS=replaced-at-build
DISABLE_FIRST_BOOT_USER_RENAME=1
# Local builds are not compressed (the workflow compresses release builds with xz).
DEPLOY_COMPRESSION=none
STAGE_LIST="stage0 stage1 stage2 stage-kiosk"
