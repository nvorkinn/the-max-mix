# Defaults for every build and for `npm run dev`; Vite loads this file automatically. Put machine-specific overrides in
# .env.local, which is not committed, or set the variable in the host's environment, which wins over this file.
# The Spotify client ID is not secret (sign-in uses PKCE). The app has no field for typing it. To use your own Spotify app,
# create it at https://developer.spotify.com/dashboard and register the redirect address shown in the app's Settings
# (for local development: http://127.0.0.1:5173/). The build bakes the value in, so rebuild after changing it.
VITE_SPOTIFY_CLIENT_ID=79012ca710ca4dd5ad18c2973510b670
