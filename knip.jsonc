{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  // Entry points come from knip's plugins rather than a list kept here: package.json scripts, index.html and the Vite and
  // Vitest configs, ESLint, Playwright (e2e/*.spec.ts), lint-staged and husky.
  // Files those do not reach directly (scripts/*.ts) are entries via package.json scripts.
  // ShellCheck and editorconfig-checker are system binaries installed separately (apt/brew/CI download), not npm dependencies.
  // The Pi's audio service is started by its systemd unit (ansible/roles/kiosk/templates/kiosk-audio.service.j2).
  "entry": ["pi/kiosk-audio/kiosk-audio.ts"],
  "ignoreBinaries": ["shellcheck", "editorconfig-checker"]
}
