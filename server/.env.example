# Spotify developer application. Create an app at https://developer.spotify.com/dashboard
# Sign-in uses PKCE, so only the client ID is needed (it is not secret); there is no client secret to configure.
SPOTIFY_CLIENT_ID=

# Redirect URI must match what you register in Spotify Dashboard:
# Use the same loopback address in Chromium. Non-loopback callbacks require HTTPS.
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/api/auth/callback

# Server port
PORT=3000
HOST=127.0.0.1

# Extra host names the app may be opened by, comma-separated (IP addresses, localhost and this machine's name are
# always allowed). Requests with any other Host header are refused to block DNS rebinding.
# ALLOWED_HOSTS=maxmix.example.lan

# browser: register Chromium as a player (requires working DRM/Widevine).
# remote: control an existing Spotify Connect device without loading the SDK.
PLAYBACK_MODE=browser

# Demo mode is explicit; failed Spotify requests never fall back to fake data.
DEMO_MODE=false

# Optional for manual development. The installed service uses /var/lib/the-max-mix.
# DATA_DIR=/home/your-user/.local/share/the-max-mix
