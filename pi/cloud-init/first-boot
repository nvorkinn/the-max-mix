#!/usr/bin/env bash
# THE MAX MIX's first-boot setup, baked into the ready-made flash image (build-image.sh) as
# /var/lib/cloud/scripts/per-instance/the-max-mix-first-boot. cloud-init runs it once on every freshly flashed card, after
# Raspberry Pi Imager's own user-data (Wi-Fi, host name, user, SSH) has been applied and the network is up. It lives in
# the image, not in user-data, because Imager writes its own user-data over whatever the card had.
#
# It runs this repository's playbook from its latest GitHub release's Pi bundle (the same run kiosk-pull.timer repeats
# later), removes the setup Wi-Fi from the card and turns cloud-init off. A failed try (no network yet, GitHub or apt
# down, or a release whose Release workflow has not uploaded its Pi bundle yet) waits a minute and tries again. Once it
# has worked, cloud-init reboots the Pi (power_state in the-max-mix.cfg): the playbook changed boot settings.
# Each step returns on failure, because set -e is ignored in an until.
set -uo pipefail
export DEBIAN_FRONTEND=noninteractive HOME=/root LC_ALL=C.UTF-8 ANSIBLE_NOCOLOR=1 GIT_TERMINAL_PROMPT=0
releases=https://github.com/nvorkinn/the-max-mix/releases
bundle=the-max-mix-pi.tar.gz
directory=/var/lib/the-max-mix/ansible-pull

pull() {
  apt-get update || return
  apt-get install --yes --no-install-recommends ansible-core ca-certificates curl git python3-apt || return
  location=$(curl --fail --silent --show-error --max-time 60 --head --output /dev/null \
    --write-out '%{redirect_url}' "$releases/latest/download/$bundle") || return
  tag=${location##*/releases/download/}
  tag=${tag%%/*}
  if [[ $location != */releases/download/* || ! $tag =~ ^v[0-9A-Za-z][0-9A-Za-z._-]*$ ]]; then
    echo "Could not find the latest release (got: ${location:-no redirect})" >&2
    return 1
  fi
  rm -rf "$directory" && mkdir -p "$directory" || return
  curl --fail --silent --show-error --max-time 300 --location "$releases/download/$tag/$bundle" \
    | tar --extract --gzip --directory "$directory" --no-same-owner || return
  # Settings for this Pi only, as kiosk-pull passes them later (see README.md).
  extra=()
  if [[ -f /etc/the-max-mix/kiosk-vars.yml ]]; then
    extra=(--extra-vars @/etc/the-max-mix/kiosk-vars.yml)
  fi
  (cd "$directory" && ansible-playbook "${extra[@]}" --inventory localhost, ansible/local.yml) || return
  echo "$tag" > /var/lib/the-max-mix/installed-release
}

until (pull); do
  echo "The first pull failed; trying again in a minute" >&2
  sleep 60
done

# The card's Wi-Fi is for the first boot only: cloud-init has made it a netplan file, which keeps the network, and the
# app's Wi-Fi screen sets up any other. So the card's copies go, with Imager's user-data, and cloud-init is turned off
# so that it never applies them again.
rm -f /boot/firmware/network-config /boot/firmware/user-data
touch /etc/cloud/cloud-init.disabled
