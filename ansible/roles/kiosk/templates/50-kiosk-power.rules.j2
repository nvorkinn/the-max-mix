// {{ ansible_managed }}
// The kiosk user may run the update now (the pull, then the restart it asks for), restart the kiosk and reboot the Pi (the
// kiosk-audio service), and nothing else to do with power or units.
polkit.addRule(function (action, subject) {
  if (subject.user !== '{{ kiosk_user }}') {
    return polkit.Result.NOT_HANDLED;
  }
  if (
    action.id === 'org.freedesktop.systemd1.manage-units' &&
    action.lookup('unit') === 'kiosk.service' &&
    action.lookup('verb') === 'restart'
  ) {
    return polkit.Result.YES;
  }
  if (
    action.id === 'org.freedesktop.systemd1.manage-units' &&
    (action.lookup('unit') === 'kiosk-pull.service' || action.lookup('unit') === 'kiosk-restart.service') &&
    action.lookup('verb') === 'start'
  ) {
    return polkit.Result.YES;
  }
  if (
    action.id === 'org.freedesktop.login1.reboot' ||
    action.id === 'org.freedesktop.login1.reboot-multiple-sessions'
  ) {
    return polkit.Result.YES;
  }
  return polkit.Result.NOT_HANDLED;
});
