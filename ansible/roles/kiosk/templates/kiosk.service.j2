# {{ ansible_managed }}
[Unit]
Description=THE MAX MIX kiosk (Cage on tty7)
# Based on Cage's own systemd example.
After=systemd-user-sessions.service systemd-logind.service dbus.socket getty@tty7.service
Wants=dbus.socket systemd-logind.service
Conflicts=getty@tty7.service
ConditionPathExists=/dev/tty0

[Service]
Type=simple
User={{ kiosk_user }}
# PAMName=login gives Cage a proper logind session, which the user's PipeWire services need.
PAMName=login
UtmpIdentifier=tty7
UtmpMode=user
TTYPath=/dev/tty7
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
StandardInput=tty-fail
StandardOutput=journal
StandardError=journal
# A screen whose own mode has an odd horizontal timing, which the Pi 4 cannot send, is left with the other modes it lists
# (1920x1080 on a 1280x800 panel). This gives the kernel that mode with even timings before Cage chooses one; it does
# nothing for any other screen (the + runs it as root, the - ignores a failure). See pi/kiosk-audio/screen-mode.ts.
ExecStartPre=-+/usr/bin/node {{ kiosk_audio_dir }}/screen-mode.ts --correct
# How to show the screen that is plugged in (kiosk_screen_rotation and kiosk_screen_scale, or the screen's own settings
# when they are empty): writes /run/kiosk/screen.env, read below and by kiosk-audio, and the touch screen's rotation
# (the + runs it as root, the - ignores a failure, which leaves the screen as it is). See pi/kiosk-audio/screen-setup.ts.
ExecStartPre=-+/usr/bin/node {{ kiosk_audio_dir }}/screen-setup.ts --rotation={{ kiosk_screen_rotation }} --scale={{ kiosk_screen_scale }}
# Show VT 7 (the + runs this as root). Cage cannot take the display while another VT is in front.
ExecStartPre=+/usr/bin/chvt 7
# Any start of the kiosk applies the changes an update left, so the scheduled restart is not needed.
ExecStartPre=+/usr/bin/rm -f {{ kiosk_restart_marker }}
# Serve the web app release the last pull installed (the + runs this as root, the - ignores a failure). It comes before
# kiosk-audio restarts below, which then serves it.
ExecStartPre=-+/usr/local/sbin/kiosk-app-switch {{ kiosk_app_dir }}
# The kiosk-audio user unit outlives a restart of this service, so it would keep running its old files: load the unit
# files again and restart it (the - ignores a failure, as when the kiosk user's manager is not running yet).
ExecStartPre=-+/usr/bin/systemctl --user -M {{ kiosk_user }}@ daemon-reload
ExecStartPre=-+/usr/bin/systemctl --user -M {{ kiosk_user }}@ try-restart kiosk-audio.service
# PAMName=login puts Cage and its children in the login session scope, so systemd signals only Cage, which then waits for
# kiosk-session to exit. Tell kiosk-session to stop first (the + runs this as root, the - ignores a failure), and wait
# for it: it waits for the kiosk shell to quit, and Cage must keep the display until then. A browser that loses its
# display crashes before writing what it last saved (a device ID saved seconds before an update's restart was lost that
# way with Chromium).
ExecStop=-+/usr/bin/pkill -TERM -f "^bash /usr/local/bin/kiosk-session"
ExecStop=-+/usr/bin/timeout 15 /usr/bin/pidwait -f "^bash /usr/local/bin/kiosk-session"
Environment=WLR_LIBINPUT_NO_DEVICES=1
# No mouse pointer on the touch screen. Cage draws the pointer itself (its own default, and the shapes the page asks for
# over the cursor-shape protocol) from the theme called "default" and ignores XCURSOR_THEME, so the folder first in
# XCURSOR_PATH holds a "default" that is the blank theme of one transparent pixel. XCURSOR_THEME covers the apps.
Environment=XCURSOR_PATH=/usr/share/kiosk-cursors:/usr/share/icons
Environment=XCURSOR_THEME=blank
Environment=KIOSK_SCREEN_OFF_AFTER={{ kiosk_screen_off_after | int }}
# KIOSK_SCREEN_ROTATION and KIOSK_SCREEN_SCALE, from screen-setup.ts above, for kiosk-session and kiosk-display, which
# turn the output and have Cage draw everything bigger. systemd reads the file when it starts Cage, after it was written.
EnvironmentFile=-/run/kiosk/screen.env
Environment="KIOSK_URL={{ kiosk_url | replace('%', '%%') }}"
ExecStart=/usr/bin/cage -d -- /usr/local/bin/kiosk-session
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
