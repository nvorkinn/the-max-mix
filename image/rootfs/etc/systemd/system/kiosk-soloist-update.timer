# Spotify Soloist builds stop working 90 days after they were built and Spotify publishes only the latest one, so it
# cannot be pinned in the image: the Pi fetches it soon after it starts (a freshly flashed or reset Pi has none) and
# then weekly.
[Unit]
Description=Install the latest Spotify Soloist regularly

[Timer]
OnBootSec=1min
OnUnitInactiveSec=1w
RandomizedDelaySec=5min

[Install]
WantedBy=timers.target
