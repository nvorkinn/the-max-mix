// Debian's security updates are on by default; also take Raspberry Pi's own archive (Chromium and the kernel come from it).
Unattended-Upgrade::Origins-Pattern:: "origin=Raspberry Pi Foundation,codename=${distro_codename}";
// Node.js for the audio service, from NodeSource's archive.
Unattended-Upgrade::Origins-Pattern:: "site=deb.nodesource.com";
