{
  "name": "the-max-mix",
  "version": "0.0.0",
  "private": true,
  "description": "THE MAX MIX: a fun collaborative Spotify tablet for Raspberry Pi 4 with Waveshare 7-inch touchscreen",
  "license": "MIT",
  "scripts": {
    "start": "npm --prefix client run preview",
    "dev": "npm --prefix client run dev",
    "build": "npm --prefix client run build",
    "kiosk:mac": "bash scripts/start-kiosk-mac.sh",
    "test": "npm --prefix client test && node --test \"scripts/test/*.test.mjs\" && bash scripts/test-kiosk.sh",
    "install:all": "npm install && npm --prefix client install",
    "lint": "npm --prefix client run lint && npm run lint:root",
    "lint:root": "eslint . --max-warnings 0",
    "lint:shell": "shellcheck scripts/*.sh",
    "lint:md": "markdownlint-cli2",
    "lint:yaml": "yamllint \".github/**/*.{yml,yaml}\" \"*.{yml,yaml}\" \"client/*.{yml,yaml}\"",
    "lint:css": "stylelint \"client/src/**/*.css\" --max-warnings 0",
    "lint:spelling": "cspell --no-progress --dot \"**/*\"",
    "lint:editorconfig": "editorconfig-checker",
    "knip": "knip",
    "lint:package-json": "npmPkgJsonLint . client && node scripts/check-version-ranges.mjs",
    "lint:lockfiles": "lockfile-lint --type npm --allowed-hosts npm --validate-https --validate-integrity --path package-lock.json --path client/package-lock.json && npm ci --dry-run --ignore-scripts --no-audit --no-fund && npm --prefix client ci --dry-run --ignore-scripts --no-audit --no-fund",
    "typecheck": "tsc -p . --noEmit && npm --prefix client run typecheck",
    "test:coverage": "npm --prefix client run test:coverage && node --test \"scripts/test/*.test.mjs\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "node scripts/install-hooks.js",
    "check": "npm run lint && npm run typecheck && npm run format:check && npm run lint:shell && npm run knip && npm run lint:spelling && npm run lint:editorconfig && npm run lint:md && npm run lint:yaml && npm run lint:css && npm run lint:package-json && npm run lint:lockfiles",
    "test:e2e": "playwright test --config e2e/playwright.config.js"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "cspell": "10.4.0",
    "eslint": "^10.13.0",
    "eslint-import-resolver-node": "^0.4.0",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-n": "^18.5.0",
    "eslint-plugin-security": "^4.2.0",
    "eslint-plugin-sonarjs": "^4.2.2",
    "eslint-plugin-unicorn": "^79.0.0",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "knip": "6.43.0",
    "lint-staged": "^17.6.0",
    "lockfile-lint": "5.1.0",
    "markdownlint-cli2": "0.24.0",
    "npm-package-json-lint": "11.0.0",
    "prettier": "^3.9.10",
    "stylelint": "17.16.0",
    "stylelint-config-standard": "40.0.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "yaml-lint": "1.7.0"
  },
  "overrides": {
    "katex": "0.19.1",
    "re2js": "2.9.1"
  },
  "engines": {
    "node": ">=24"
  }
}
