# {{ ansible_managed }}
# A user unit, enabled for every user but run only for the kiosk user: it needs that user's PipeWire session, which
# kiosk.service's login session starts.
[Unit]
Description=THE MAX MIX audio routing (keeps the browser's sound on the chosen AirPlay speakers)
ConditionUser={{ kiosk_user }}
Wants=pipewire.service wireplumber.service
After=pipewire.service wireplumber.service

[Service]
Environment=KIOSK_APP_ORIGIN={{ kiosk_app_origin }}
# The web app this service serves (app-files.ts), the release kiosk-app-switch made current when the kiosk started.
Environment=KIOSK_APP_DIR={{ kiosk_app_dir }}/current
# The port the Sonos speakers send their events to (sonos-events.ts), on the Pi's home network address. The sonos-ts
# library opens it the first time the app listens. It takes events only for the subscriptions it holds (anything else
# gets 412) and otherwise answers just its /status and /health pages.
Environment=SONOS_LISTENER_PORT={{ kiosk_sonos_events_port }}
# How far the screen is turned and how much bigger it is drawn (KIOSK_SCREEN_ROTATION, KIOSK_SCREEN_SCALE), which
# screen-setup.ts writes as kiosk.service starts, before it restarts this service: for the size GET /screen answers
# (screen.ts), and for kiosk-display when this service wakes the screen.
EnvironmentFile=-/run/kiosk/screen.env
ExecStart=/usr/bin/node {{ kiosk_audio_dir }}/kiosk-audio.ts watch
Restart=always
RestartSec=2
NoNewPrivileges=yes
LockPersonality=yes
# PipeWire's socket, the app's requests on 127.0.0.1 (server.ts), the Sonos events port above, and the sonos-ts library (sonos.ts),
# which finds the Sonos speakers on the home network, talks to them and takes their events, and reads the network
# interfaces over netlink. So there is no IP address allow list: the speakers are wherever the home network puts them.
# Spotify Soloist, which this service runs (soloist.ts) and which inherits these limits, also reaches Spotify and
# announces itself to phones over IPv6.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK

[Install]
WantedBy=default.target
