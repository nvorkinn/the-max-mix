# {{ ansible_managed }}
[Unit]
Description=THE MAX MIX kiosk (Cage on tty7)
# Based on Cage's own systemd example. Cage fails to display if it starts before Plymouth has quit.
After=systemd-user-sessions.service plymouth-quit-wait.service systemd-logind.service dbus.socket getty@tty7.service
Wants=dbus.socket systemd-logind.service plymouth-quit.service
Conflicts=getty@tty7.service
ConditionPathExists=/dev/tty0

[Service]
Type=simple
User={{ kiosk_user }}
# PAMName=login gives Cage a proper logind session, which the user's PipeWire services need.
PAMName=login
UtmpIdentifier=tty7
UtmpMode=user
TTYPath=/dev/tty7
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
StandardInput=tty-fail
StandardOutput=journal
StandardError=journal
# Show VT 7 (the + runs this as root). Cage cannot take the display while another VT is in front.
ExecStartPre=+/usr/bin/chvt 7
# Any start of the kiosk applies the changes an update left, so the scheduled restart is not needed.
ExecStartPre=+/usr/bin/rm -f {{ kiosk_restart_marker }}
# The kiosk-audio user unit outlives a restart of this service, so it would keep running its old files: load the unit
# files again and restart it (the - ignores a failure, as when the kiosk user's manager is not running yet).
ExecStartPre=-+/usr/bin/systemctl --user -M {{ kiosk_user }}@ daemon-reload
ExecStartPre=-+/usr/bin/systemctl --user -M {{ kiosk_user }}@ try-restart kiosk-audio.service
# PAMName=login puts Cage and its children in the login session scope, so systemd signals only Cage, which then waits for
# kiosk-session to exit. Tell kiosk-session to stop first (the + runs this as root, the - ignores a failure).
ExecStop=-+/usr/bin/pkill -TERM -f "^bash /usr/local/bin/kiosk-session"
Environment=WLR_LIBINPUT_NO_DEVICES=1
# No mouse pointer on the touch screen. Cage draws the pointer itself (its own default, and the shapes Chromium asks for
# over the cursor-shape protocol) from the theme called "default" and ignores XCURSOR_THEME, so the folder first in
# XCURSOR_PATH holds a "default" that is the blank theme of one transparent pixel. XCURSOR_THEME covers the apps.
Environment=XCURSOR_PATH=/usr/share/kiosk-cursors:/usr/share/icons
Environment=XCURSOR_THEME=blank
Environment=KIOSK_SCREEN_OFF_AFTER={{ kiosk_screen_off_after | int }}
Environment="KIOSK_URL={{ kiosk_url | replace('%', '%%') }}"
ExecStart=/usr/bin/cage -d -- /usr/local/bin/kiosk-session
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
