{
  "//": "Only used by ESLint's type-aware rules for the repository tooling; client/ has its own tsconfig.json.",
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "noPropertyAccessFromIndexSignature": true,
    "isolatedModules": true,
    "erasableSyntaxOnly": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["scripts/*.js", "scripts/*.mjs", "scripts/test/*.mjs", "e2e/*.js", "*.config.js", "*.config.mjs"]
}
