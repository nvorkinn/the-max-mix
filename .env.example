# Copy to .env for `npm run dev`. The build bakes this variable in, so rebuild after changing it.
# The Spotify client ID is not secret (sign-in uses PKCE). Create the app at https://developer.spotify.com/dashboard and
# register the redirect address shown in the app's Settings (for local development: http://127.0.0.1:5173/).
# The app has no field for typing the ID; without this variable Spotify sign-in is unavailable (demo mode still works).
VITE_SPOTIFY_CLIENT_ID=
