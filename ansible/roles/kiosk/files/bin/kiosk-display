#!/usr/bin/env bash
# Turns the screen off and on, inside the Cage session (it needs Cage's WAYLAND_DISPLAY):
#   kiosk-display off                  from swayidle (kiosk-session), once the app let the screen sleep and nobody touched it
#   kiosk-display on                   from swayidle at the first touch after that, and from the kiosk-audio service when the
#                                      app wakes the screen for music that starts while it sleeps
#   kiosk-display fit                  from kiosk-session before Chromium starts: scales each output to fit the app
# Cage has no output power protocol, so the HDMI output is disabled and enabled again through wlr-randr. Without a signal
# the Waveshare screen should turn its backlight off; the app's black sleep screen covers it if it does not.
set -u

# The outputs Cage has: wlr-randr starts each one's block with its name at the start of a line.
outputs() {
  wlr-randr | awk '/^[^ \t]/ { print $1 }'
}

# The app is laid out for a 1024x600 screen. A bigger one, such as a 10.1 inch 1280x800, gets an output scale that makes
# it that size or a little taller (1.25 there, so 1024x640), so the app fills it and touches land where they look.
# Chromium's own --force-device-scale-factor drew only part of the page under Cage. Cage has no fractional scaling for
# its clients, so Chromium draws at twice the size and Cage shrinks that to the screen, which keeps text sharp.
# Prints each output's name, the scale it should have (from its current mode, or its preferred one; 1 when there is
# neither), the scale it has, and yes or no for on or off.
design_width=1024
design_height=600
scales() {
  wlr-randr | awk -v dw="$design_width" -v dh="$design_height" '
    function fit(line, size, scale) {
      match(line, /[0-9]+x[0-9]+ px/)
      split(substr(line, RSTART, RLENGTH - 3), size, "x")
      scale = size[1] / dw
      return size[2] / dh < scale ? size[2] / dh : scale
    }
    function done() {
      if (name != "") printf "%s %.2f %.2f %s\n", name, (current ? current : preferred ? preferred : 1), now, enabled
    }
    /^[^ \t]/ { done(); name = $1; current = 0; preferred = 0; now = 1; enabled = "no" }
    /^[ \t]+Enabled:/ { enabled = $2 }
    /^[ \t]+Scale:/ { now = $2 }
    /[1-9][0-9]*x[1-9][0-9]* px.*current/ { current = fit($0) }
    /[1-9][0-9]*x[1-9][0-9]* px.*preferred/ { preferred = fit($0) }
    END { done() }'
}

# Sets the scale of the outputs whose scale is not the one they should have, so the 7 inch screen is left alone.
fit() {
  local output scale now enabled status=0
  while read -r output scale now enabled; do
    [[ -n $output && $enabled == yes && $scale != "$now" ]] || continue
    wlr-randr --output "$output" --scale "$scale" || status=1
  done < <(scales)
  return "$status"
}

# An output that is turned off forgets its scale and comes back at 1, and Chromium, resized twice in a row when the
# scale is set again after that, can keep drawing at the size in between (part of the screen white). So "off" keeps
# each output's scale here and "on" turns the output on at that scale in one step.
saved_scales=/run/kiosk/display-scales

turn() {
  local state=$1 output scale enabled saved status=0
  if [[ $state == on ]]; then
    # _ is the scale the output has now, which is 1 while it is off.
    while read -r output scale _ enabled; do
      [[ -n $output && $enabled != yes ]] || continue
      saved=$(awk -v name="$output" '$1 == name { print $2 }' "$saved_scales" 2> /dev/null)
      [[ -n $saved ]] && scale=$saved
      # Enabling without a mode can fail where the firmware set none; the preferred mode is the one Cage started with.
      wlr-randr --output "$output" --on --scale "$scale" ||
        wlr-randr --output "$output" --on --preferred --scale "$scale" || status=1
    done < <(scales)
  else
    # Only an output that is on has its real scale; one already off keeps the scale saved when it went off.
    wlr-randr | awk '
      /^[^ \t]/ { name = $1 }
      /^[ \t]+Enabled: yes/ { on[name] = 1 }
      /^[ \t]+Scale:/ && on[name] { print name, $2 }' > "$saved_scales.new"
    if [[ -s $saved_scales.new ]]; then mv "$saved_scales.new" "$saved_scales"; else rm -f "$saved_scales.new"; fi
    while read -r output; do
      [[ -n $output ]] || continue
      wlr-randr --output "$output" --off || status=1
    done < <(outputs)
  fi
  return "$status"
}

case ${1:-} in
  on) turn on ;;
  fit) fit ;;
  off) turn off ;;
  *)
    echo "kiosk-display: unknown command: ${1:-}" >&2
    exit 1
    ;;
esac
