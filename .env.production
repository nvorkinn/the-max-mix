# countdown-server (src/countdown/server.ts), countdown.build being the dev server and countdown.run the production one;
# the Max Mix has one deployment, on dev. Each is the exact name, since a redirect would drop the device secret.
# The settings site, whose /register page the kiosk registers through (behind the owner's sign-in).
VITE_COUNTDOWN_SERVER=https://app.countdown.build
# The screens' API, which the kiosk reads its config from and saves it to with the device secret. Not the settings
# site: everything there but its sign-up and static pages is behind the sign-in, which turns the secret away.
VITE_COUNTDOWN_API=https://api.countdown.build
