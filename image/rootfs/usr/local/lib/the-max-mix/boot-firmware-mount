#!/bin/sh
# Run by kiosk-boot-firmware.service: mounts the boot partition this boot started from at /boot/firmware, so the screen
# setup can write the screen's mode into its cmdline.txt. The firmware says which partition in the device tree (a u32):
# 2 is slot a's, 3 is slot b's (pi/kiosk-audio/boot-slots.ts).
set -eu
partition=$(od -An -tx1 -N4 /proc/device-tree/chosen/bootloader/partition | tr -d ' \n')
case $((0x$partition)) in
  2) slot=a ;;
  3) slot=b ;;
  *)
    echo "The Pi started from partition $((0x$partition)), which is no slot's." >&2
    exit 1
    ;;
esac
exec /usr/bin/mount -o noatime,umask=0022 "/dev/disk/by-partlabel/boot-$slot" /boot/firmware
