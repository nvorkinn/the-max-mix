#!/bin/bash
# Usage: kiosk-soloist-update
# Installs the latest Spotify Soloist (Spotify's headless Spotify Connect player) as /data/soloist/soloist, which
# /usr/local/bin/soloist links to. Run by kiosk-soloist-update.timer. Spotify only publishes the latest build, and a
# build stops working 90 days after it was built (it exits with 10), so the Pi fetches it again regularly. The terms do
# not allow passing the binary on, so it is never part of the image: it lives on /data, outside the slots, and outlives
# every update. A failed download, or a build that does not run, leaves the one that is there. kiosk-server runs it
# (server/src/soloist.ts): a running player keeps its old copy until the kiosk next starts, so music is not cut
# off, and one that had expired is started again within the hour.
set -euo pipefail

if (($# != 0)); then
  echo "usage: $0" >&2
  exit 2
fi
target=/data/soloist/soloist

case $(uname -m) in
  aarch64) arch=arm64 ;;
  armv7l) arch=arm32 ;;
  x86_64) arch=x86_64 ;;
  *)
    echo "kiosk-soloist-update: no Soloist build for $(uname -m)" >&2
    exit 1
    ;;
esac

work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT
curl --fail --silent --show-error --location --max-time 300 --retry 2 --output "$work/soloist.tar.gz" \
  "https://soloist-builds.spotifycdn.com/soloist_release_$arch.tar.gz"
tar -xzf "$work/soloist.tar.gz" -C "$work" soloist
if ! version=$("$work/soloist" --version 2>&1); then
  echo "kiosk-soloist-update: the downloaded build does not run: $version" >&2
  exit 1
fi

install -d -m 0755 -o root -g root "$(dirname "$target")"
if cmp -s "$work/soloist" "$target"; then
  echo "kiosk-soloist-update: $version is already installed"
else
  install -m 0755 -o root -g root "$work/soloist" "$target.new"
  mv -f "$target.new" "$target"
  echo "kiosk-soloist-update: installed $version"
fi

