// The kiosk user may restart the kiosk, start an update check or install (kiosk-update.service), start a factory reset
// (kiosk-reset.service, the debug console's Factory reset) and reboot the Pi, for the kiosk-audio service, and nothing
// else to do with power or units.
polkit.addRule(function (action, subject) {
  if (subject.user !== 'kiosk') {
    return polkit.Result.NOT_HANDLED;
  }
  if (
    action.id === 'org.freedesktop.systemd1.manage-units' &&
    action.lookup('unit') === 'kiosk.service' &&
    action.lookup('verb') === 'restart'
  ) {
    return polkit.Result.YES;
  }
  if (
    action.id === 'org.freedesktop.systemd1.manage-units' &&
    (action.lookup('unit') === 'kiosk-update.service' || action.lookup('unit') === 'kiosk-reset.service') &&
    action.lookup('verb') === 'start'
  ) {
    return polkit.Result.YES;
  }
  if (
    action.id === 'org.freedesktop.login1.reboot' ||
    action.id === 'org.freedesktop.login1.reboot-multiple-sessions'
  ) {
    return polkit.Result.YES;
  }
  return polkit.Result.NOT_HANDLED;
});
