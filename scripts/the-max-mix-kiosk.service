[Unit]
Description=THE MAX MIX Chromium kiosk
PartOf=graphical-session.target
Wants=the-max-mix-server.service
After=the-max-mix-server.service
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStart=/bin/bash "@ROOT@/scripts/start-kiosk.sh"
EnvironmentFile="@ENV@"
Environment="KIOSK_PROFILE=@HOME@/.config/the-max-mix/chromium"
Restart=always
RestartSec=5
TimeoutStopSec=15
