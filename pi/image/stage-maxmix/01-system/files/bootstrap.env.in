# Settings for the-max-mix-bootstrap.service, which installs THE MAX MIX with ansible-pull on the first boot with internet.
# Changes only matter until the first successful run (/var/lib/the-max-mix/bootstrapped). To run it again, delete that
# file, then: sudo systemctl start the-max-mix-bootstrap.service
#
# The address the kiosk opens. Register exactly this address, trailing slash included, in the Spotify dashboard.
KIOSK_URL=@KIOSK_URL@
# Where the Ansible playbook comes from, and the branch or tag of it to use (releases pin the tag they were built from).
PLAYBOOK_REPO=@PLAYBOOK_REPO@
PLAYBOOK_REF=@PLAYBOOK_REF@
# The desktop user that runs the kiosk. Empty means the first desktop user (uid 1000), whatever it is called.
KIOSK_USER=
