[Unit]
Description=THE MAX MIX local web server (the unpacked release, loopback only)
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStart=/bin/bash "@ROOT@/scripts/serve-kiosk.sh"
EnvironmentFile="@ENV@"
Environment="KIOSK_APP_DIR=@ROOT@/app"
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
