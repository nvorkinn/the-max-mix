# Installs the latest Spotify Soloist on /data (see the script). A failure only shows up in the journal
# (journalctl -u kiosk-soloist-update): the build that is there stays, and the timer tries again.
[Unit]
Description=Install the latest Spotify Soloist
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# On the Pi's own setup hotspot there is no internet (NetworkManager still counts it as up), so the job is skipped
# cleanly rather than failing; joining a real network starts it again (50-kiosk-online).
ExecCondition=/bin/sh -c 'ip route show default | grep -q .'
ExecStart=/usr/local/sbin/kiosk-soloist-update
TimeoutStartSec=10min
