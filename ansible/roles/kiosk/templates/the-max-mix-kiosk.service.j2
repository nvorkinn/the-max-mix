# {{ ansible_managed }}
[Unit]
Description=THE MAX MIX Chromium kiosk
PartOf=graphical-session.target
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStart=/bin/bash "{{ kiosk_scripts_dir | replace('%', '%%') }}/start-kiosk.sh"
EnvironmentFile="{{ kiosk_config_dir | replace('%', '%%') }}/kiosk.env"
Environment="KIOSK_PROFILE={{ kiosk_config_dir | replace('%', '%%') }}/chromium"
Restart=always
RestartSec=5
TimeoutStopSec=15
